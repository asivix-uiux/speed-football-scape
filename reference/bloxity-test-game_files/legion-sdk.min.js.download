0;\n  transition: opacity 0.2s ease;\n  pointer-events: none;\n}\n\n.legion-customizer-overlay.open {\n  opacity: 1;\n  pointer-events: auto;\n}\n\n.legion-customizer {\n  position: fixed;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%) scale(0.95);\n  width: min(860px, 94vw);\n  height: min(560px, 86vh);\n  background: linear-gradient(180deg, #1a1d21 0%, #0f1419 100%);\n  border: 1px solid #2a2d31;\n  border-radius: 16px;\n  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);\n  z-index: 999999;\n  opacity: 0;\n  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);\n  pointer-events: none;\n  display: flex;\n  flex-direction: row;\n  overflow: hidden;\n  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n}\n\n/* Left: live 3D character preview (meeland-style split). */\n.legion-customizer-preview {\n  position: relative;\n  flex: 0 0 42%;\n  min-width: 0;\n  background: #0f1419;\n  border-right: 1px solid #2a2d31;\n  overflow: hidden;\n}\n\n.legion-customizer-preview canvas {\n  display: block;\n}\n\n.legion-customizer-preview-label {\n  position: absolute;\n  top: 12px;\n  left: 16px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 13px;\n  font-weight: 600;\n  color: rgba(255, 255, 255, 0.9);\n  pointer-events: none;\n  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);\n  z-index: 2;\n}\n\n.legion-customizer-preview-loading {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #5b6b7a;\n  font-size: 13px;\n}\n\n/* Right: header + tabs + item grid + footer. */\n.legion-customizer-panel {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n}\n\n@media (max-width: 640px) {\n  .legion-customizer {\n    flex-direction: column;\n    height: min(640px, 92vh);\n  }\n  .legion-customizer-preview {\n    flex: 0 0 36%;\n    border-right: none;\n    border-bottom: 1px solid #2a2d31;\n  }\n}\n\n.legion-customizer.open {\n  opacity: 1;\n  transform: translate(-50%, -50%) scale(1);\n  pointer-events: auto;\n}\n\n.legion-customizer-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 16px 20px;\n  border-bottom: 1px solid #2a2d31;\n  background: rgba(255, 255, 255, 0.02);\n}\n\n.legion-customizer-title {\n  font-size: 18px;\n  font-weight: 600;\n  color: #fff;\n  margin: 0;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.legion-customizer-title svg {\n  width: 22px;\n  height: 22px;\n  color: #00a2ff;\n}\n\n.legion-customizer-close {\n  width: 32px;\n  height: 32px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: transparent;\n  border: none;\n  border-radius: 8px;\n  cursor: pointer;\n  color: #838384;\n  transition: all 0.15s ease;\n}\n\n.legion-customizer-close:hover {\n  background: rgba(255, 255, 255, 0.1);\n  color: #fff;\n}\n\n.legion-customizer-tabs {\n  display: flex;\n  gap: 8px;\n  padding: 12px 20px;\n  background: rgba(0, 0, 0, 0.2);\n  border-bottom: 1px solid #2a2d31;\n}\n\n.legion-customizer-tab {\n  padding: 8px 16px;\n  border-radius: 20px;\n  font-size: 13px;\n  font-weight: 500;\n  background: transparent;\n  border: none;\n  color: #838384;\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.legion-customizer-tab:hover {\n  background: rgba(255, 255, 255, 0.05);\n  color: #b0b0b0;\n}\n\n.legion-customizer-tab.active {\n  background: #00a2ff;\n  color: #fff;\n}\n\n.legion-customizer-body {\n  flex: 1;\n  overflow-y: auto;\n  overflow-x: hidden;\n  padding: 16px;\n  min-height: 0; /* Critical for flex scroll */\n  scrollbar-width: thin;\n  scrollbar-color: #3a3d41 transparent;\n}\n\n.legion-customizer-body::-webkit-scrollbar {\n  width: 8px;\n}\n\n.legion-customizer-body::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n.legion-customizer-body::-webkit-scrollbar-thumb {\n  background: #3a3d41;\n  border-radius: 4px;\n}\n\n.legion-customizer-body::-webkit-scrollbar-thumb:hover {\n  background: #4a4d51;\n}\n\n.legion-customizer-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));\n  gap: 12px;\n}\n\n.legion-customizer-item {\n  position: relative;\n  aspect-ratio: 1;\n  background: #2a2d31;\n  border-radius: 12px;\n  border: 2px solid transparent;\n  cursor: pointer;\n  transition: all 0.15s ease;\n  overflow: hidden;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.legion-customizer-item:hover {\n  border-color: #00a2ff;\n  transform: translateY(-2px);\n}\n\n.legion-customizer-item.equipped {\n  border-color: #00a2ff;\n  background: rgba(0, 162, 255, 0.15);\n}\n\n.legion-customizer-item-img {\n  width: 80%;\n  height: 80%;\n  object-fit: contain;\n}\n\n.legion-customizer-item-check {\n  position: absolute;\n  top: 6px;\n  right: 6px;\n  width: 20px;\n  height: 20px;\n  background: #00a2ff;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  opacity: 0;\n  transform: scale(0.5);\n  transition: all 0.15s ease;\n}\n\n.legion-customizer-item.equipped .legion-customizer-item-check {\n  opacity: 1;\n  transform: scale(1);\n}\n\n.legion-customizer-item-check svg {\n  width: 12px;\n  height: 12px;\n  color: #fff;\n}\n\n.legion-customizer-item-name {\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  padding: 6px;\n  background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));\n  font-size: 10px;\n  font-weight: 500;\n  color: #fff;\n  text-align: center;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.legion-customizer-empty {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 40px 20px;\n  text-align: center;\n  color: #838384;\n}\n\n.legion-customizer-empty svg {\n  width: 48px;\n  height: 48px;\n  margin-bottom: 16px;\n  opacity: 0.5;\n}\n\n.legion-customizer-empty-text {\n  font-size: 14px;\n  margin-bottom: 8px;\n}\n\n.legion-customizer-empty-hint {\n  font-size: 12px;\n  opacity: 0.7;\n}\n\n.legion-customizer-loading {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 60px 20px;\n  color: #838384;\n}\n\n.legion-customizer-spinner {\n  width: 32px;\n  height: 32px;\n  border: 3px solid #2a2d31;\n  border-top-color: #00a2ff;\n  border-radius: 50%;\n  animation: legion-spin 0.8s linear infinite;\n  margin-bottom: 12px;\n}\n\n@keyframes legion-spin {\n  to { transform: rotate(360deg); }\n}\n\n.legion-customizer-footer {\n  padding: 12px 20px;\n  border-top: 1px solid #2a2d31;\n  background: rgba(0, 0, 0, 0.2);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.legion-customizer-hint {\n  font-size: 11px;\n  color: #838384;\n}\n\n.legion-customizer-hint kbd {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 20px;\n  padding: 2px 6px;\n  background: #2a2d31;\n  border-radius: 4px;\n  font-family: inherit;\n  font-size: 10px;\n  color: #b0b0b0;\n  margin: 0 2px;\n}\n\n.legion-customizer-shop-link {\n  font-size: 12px;\n  color: #00a2ff;\n  text-decoration: none;\n  transition: color 0.15s ease;\n}\n\n.legion-customizer-shop-link:hover {\n  color: #33b5ff;\n}\n\n/* Bux balance in header */\n.legion-customizer-bux {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 6px 12px;\n  background: linear-gradient(135deg, #2a2d31 0%, #1a1d21 100%);\n  border-radius: 20px;\n  font-size: 13px;\n  font-weight: 600;\n  color: #ffffff;\n}\n\n.legion-customizer-bux-add {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 20px;\n  height: 20px;\n  background: linear-gradient(135deg, #4ade80 0%, #22c55e 100%);\n  border: none;\n  border-radius: 50%;\n  cursor: pointer;\n  color: #fff;\n  font-size: 14px;\n  font-weight: bold;\n  line-height: 1;\n  transition: all 0.15s ease;\n  margin-left: 4px;\n}\n\n.legion-customizer-bux-add:hover {\n  background: linear-gradient(135deg, #6ee7a0 0%, #4ade80 100%);\n  transform: scale(1.1);\n}\n\n.legion-customizer-bux svg {\n  width: 16px;\n  height: 16px;\n}\n\n/* Unowned item styles */\n.legion-customizer-item.unowned {\n  opacity: 0.6;\n  filter: grayscale(0.3);\n}\n\n.legion-customizer-item.unowned:hover {\n  opacity: 0.9;\n  filter: grayscale(0);\n  border-color: #00a2ff;\n}\n\n.legion-customizer-item-price {\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  padding: 4px 6px;\n  background: linear-gradient(transparent, rgba(0, 0, 0, 0.9));\n  font-size: 11px;\n  font-weight: 600;\n  color: #ffffff;\n  text-align: center;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 4px;\n}\n\n.legion-customizer-item-price svg {\n  width: 12px;\n  height: 12px;\n}\n\n.legion-customizer-item-price.free {\n  color: #4ade80;\n}\n\n/* Purchase confirmation modal */\n.legion-customizer-modal-overlay {\n  position: absolute;\n  inset: 0;\n  background: rgba(0, 0, 0, 0.8);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 10;\n  opacity: 0;\n  pointer-events: none;\n  transition: opacity 0.2s ease;\n}\n\n.legion-customizer-modal-overlay.open {\n  opacity: 1;\n  pointer-events: auto;\n}\n\n.legion-customizer-modal {\n  background: linear-gradient(180deg, #1a1d21 0%, #0f1419 100%);\n  border: 1px solid #2a2d31;\n  border-radius: 16px;\n  padding: 24px;\n  max-width: 320px;\n  width: 90%;\n  text-align: center;\n}\n\n.legion-customizer-modal-icon {\n  width: 80px;\n  height: 80px;\n  margin: 0 auto 16px;\n  background: #2a2d31;\n  border-radius: 12px;\n  overflow: hidden;\n}\n\n.legion-customizer-modal-icon img {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  padding: 8px;\n}\n\n.legion-customizer-modal-title {\n  font-size: 18px;\n  font-weight: 600;\n  color: #fff;\n  margin: 0 0 8px;\n}\n\n.legion-customizer-modal-price {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  font-size: 20px;\n  font-weight: 700;\n  color: #ffffff;\n  margin-bottom: 20px;\n}\n\n.legion-customizer-modal-price svg {\n  width: 20px;\n  height: 20px;\n}\n\n.legion-customizer-modal-price.free {\n  color: #4ade80;\n}\n\n.legion-customizer-modal-balance {\n  font-size: 12px;\n  color: #838384;\n  margin-bottom: 16px;\n}\n\n.legion-customizer-modal-balance span {\n  color: #00a2ff;\n  font-weight: 600;\n}\n\n.legion-customizer-modal-error {\n  font-size: 12px;\n  color: #ef4444;\n  margin-bottom: 16px;\n}\n\n.legion-customizer-modal-buttons {\n  display: flex;\n  gap: 12px;\n}\n\n.legion-customizer-modal-btn {\n  flex: 1;\n  padding: 12px 16px;\n  border-radius: 8px;\n  font-size: 14px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.15s ease;\n  border: none;\n}\n\n.legion-customizer-modal-btn.cancel {\n  background: #2a2d31;\n  color: #b0b0b0;\n}\n\n.legion-customizer-modal-btn.cancel:hover {\n  background: #3a3d41;\n  color: #fff;\n}\n\n.legion-customizer-modal-btn.confirm {\n  background: linear-gradient(135deg, #00a2ff 0%, #0077cc 100%);\n  color: #fff;\n}\n\n.legion-customizer-modal-btn.confirm:hover {\n  background: linear-gradient(135deg, #33b5ff 0%, #0088dd 100%);\n}\n\n.legion-customizer-modal-btn.confirm:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.legion-customizer-modal-btn.confirm.free {\n  background: linear-gradient(135deg, #4ade80 0%, #22c55e 100%);\n}\n\n.legion-customizer-modal-btn.confirm.free:hover {\n  background: linear-gradient(135deg, #6ee7a0 0%, #4ade80 100%);\n}\n\n/* Load more indicator */\n.legion-customizer-load-more {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 20px;\n  color: #838384;\n  font-size: 12px;\n  gap: 8px;\n}\n\n.legion-customizer-load-more-spinner {\n  width: 16px;\n  height: 16px;\n  border: 2px solid #2a2d31;\n  border-top-color: #00a2ff;\n  border-radius: 50%;\n  animation: legion-spin 0.8s linear infinite;\n}\n",document.head.app